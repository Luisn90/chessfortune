---
import { modes } from '../data/site';
---

<section class="py-24 lg:py-36">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="mb-16 flex flex-wrap items-end justify-between gap-8">
      <div>
        <p data-reveal="wipe" class="eyebrow mb-5">El reloj · Ritmos</p>
        <h2 data-reveal="mask" style="--reveal-delay:90ms" class="max-w-2xl text-[length:var(--text-display)]">
          Elige a qué velocidad<br /> quieres <span class="text-gilded">ganar</span>.
        </h2>
      </div>
      <p data-reveal="up" style="--reveal-delay:200ms" class="max-w-xs text-sm text-mist">Cuatro ritmos oficiales. El bote y el rival cambian, la tensión no.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {modes.map((m, i) => (
        <article
          data-reveal="up"
          style={`--reveal-delay:${i * 90}ms`}
          class="tilt spotlight group relative overflow-hidden rounded-card border border-line bg-surface/40 p-8 hover:border-gold/45 hover:bg-surface"
        >
          <div class="relative flex h-full flex-col">
            <span class="eyebrow text-[0.58rem]">{m.heat}</span>
            <h3 class="mt-6 font-display text-4xl text-white transition-colors duration-500 group-hover:text-gold-soft">{m.name}</h3>
            <p class="mt-3 font-sans text-3xl font-light tracking-tight text-gold/70">{m.time}</p>
            <p class="mt-6 grow text-sm leading-relaxed text-mist">{m.desc}</p>
            <span class="mt-8 flex items-center gap-2 font-sans text-[0.68rem] uppercase tracking-[0.2em] text-mist transition-colors duration-400 group-hover:text-gold">
              Entrar a sala
              <span class="transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5">→</span>
            </span>
          </div>

          <div class="pointer-events-none absolute -bottom-8 -right-8 grid size-32 grid-cols-4 overflow-hidden rounded-card opacity-0 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-bottom-4 group-hover:-right-4 group-hover:opacity-100" aria-hidden="true">
            {Array.from({ length: 16 }).map((_, k) => {
              const goldSq = (Math.floor(k / 4) + k) % 2 === 0;
              return <span class={goldSq ? 'bg-gold/12' : 'bg-transparent'} />;
            })}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
