---
import { site } from '../data/site';

/* Sustituye por las fotos reales en /public/img/ */
const shots = [
  { src: '/img/social-01.jpg', alt: 'Partida en curso en Chess Fortune' },
  { src: '/img/social-02.jpg', alt: 'Jugadores de la comunidad Chess Fortune' },
  { src: '/img/social-03.jpg', alt: 'Torneo de la beta cerrada' },
  { src: '/img/social-04.jpg', alt: 'Tablero cosmético exclusivo' },
  { src: '/img/social-05.jpg', alt: 'Ganador de un bote de Seeds' },
];
---

<section class="relative overflow-hidden py-24 lg:py-36">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <hr class="rule rule-fade mb-24 lg:mb-32" />
    <div class="flex flex-wrap items-end justify-between gap-10">
      <h2 data-reveal="mask" class="text-[length:var(--text-display)]">Comparte con<br /><span class="text-gilded">#ChessFortune</span></h2>
      <div data-reveal="up" style="--reveal-delay:150ms" class="flex flex-wrap items-center gap-8">
        <p class="text-sm text-mist">
          Síguenos en <a href={site.instagram} rel="noopener" class="link-underline ml-1 text-gold">@chessfortune</a>
        </p>
        <a href={site.discord} rel="noopener" class="btn-gold px-8 py-3.5 font-sans text-[0.72rem] font-medium uppercase tracking-[0.2em] text-navy">Únete al Discord</a>
      </div>
    </div>
  </div>

  <div class="no-bar mt-16 flex gap-4 overflow-x-auto px-6 pb-6 lg:px-10">
    {shots.map((s, i) => (
      <figure
        data-reveal="up"
        style={`--reveal-delay:${i * 90}ms; margin-top:${(i % 3) * 2.2}rem`}
        class="tilt group relative aspect-4/5 w-[62vw] shrink-0 overflow-hidden rounded-card border border-line bg-surface sm:w-[30vw] lg:w-[19vw]"
      >
        <img src={s.src} alt={s.alt} loading="lazy" decoding="async" width="480" height="600" class="size-full object-cover opacity-70 grayscale transition-all duration-800 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105 group-hover:opacity-100 group-hover:grayscale-0" />
        <figcaption class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-navy to-transparent p-5 font-sans text-[0.68rem] uppercase tracking-[0.18em] text-gold transition-transform duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-y-0">Ver en Instagram</figcaption>
      </figure>
    ))}
  </div>
</section>
